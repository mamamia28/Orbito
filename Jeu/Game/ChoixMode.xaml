<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game.ChoixMode">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="orbitowhite_nobg.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Logo Orbito" />

            <Label
                Text="Choisissez un Mode de Jeu"
                FontSize="24"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" 
                />

            <HorizontalStackLayout
                Padding="30"
                Spacing="25"
                HorizontalOptions="Center"
                
                >
                <Button 
                    Text="Joueur VS IA"
                    WidthRequest="500"
                    HeightRequest="60"
                    FontSize="30"
                />
                <Button
                    Text="IA VS IA"
                    WidthRequest="500"
                    HeightRequest="60"
                    FontSize="30"
                    />

            </HorizontalStackLayout>

            <Button
                Text="Joueur VS Joueur"
                WidthRequest="700"
                HeightRequest="70"
                FontSize="40"
                />

            <Grid Padding="30">

                <Button
                    Text="Retour"
                    WidthRequest="200"
                    HeightRequest="70"
                    FontSize="30"
                    BackgroundColor="Red"
                    TextColor="Black"
                    HorizontalOptions="Start"
                    BorderColor="Black"
                    BorderWidth="3"
                    Grid.Column="0"
                    />

                <Button
                    Text="Variantes"
                    WidthRequest="200"
                    HeightRequest="70"
                    FontSize="30"
                    BackgroundColor="Purple"
                    TextColor="Black"
                    HorizontalOptions="End"
                    BorderColor="Black"
                    BorderWidth="3"
                    Grid.Column="1"
                    />

            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
