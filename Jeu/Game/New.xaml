<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game.New">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="orbitowhite_nobg.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Logo Orbito" />

            

            <HorizontalStackLayout
                Padding="30"
                Spacing="200"
                HorizontalOptions="Center"
                BackgroundColor="DarkViolet"
                >
                <VerticalStackLayout
                    Margin="20"
                    WidthRequest="400"
                    Spacing="15"
                    
                    
                    >
                    <Label
                        Text="Joueur 1"
                        />
                    <Image
                        Source="dotnet_bot.png"
                        Aspect="AspectFill"
                        />
                    <Entry
                        Placeholder="Entrez le pseudo ici"
                        />

                </VerticalStackLayout>
                <VerticalStackLayout
                    Margin="10"
                    WidthRequest="400"
                    Spacing="15"
                    >
                    <Label
                        Text="Joueur 2"
                        />
                    <Image
                        Source="dotnet_bot.png"
                        Aspect="AspectFill"
                        />
                    <Entry
                        Placeholder="Entrez le pseudo ici"
                        />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Button
                Text="Lancer la partie"
                WidthRequest="700"
                HeightRequest="70"
                FontSize="40"
                />

            <Grid Padding="20">

                <Button
                    Text="Retour"
                    WidthRequest="200"
                    HeightRequest="70"
                    FontSize="30"
                    BackgroundColor="Red"
                    TextColor="Black"
                    HorizontalOptions="Start"
                    BorderColor="Black"
                    BorderWidth="3"
                    
                    Grid.Column="0"
                    />

                

            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
