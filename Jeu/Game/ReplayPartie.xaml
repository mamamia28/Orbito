<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Game.Models"
             xmlns:local="clr-namespace:Game.Behaviors"
             x:Class="Game.ReplayPartie"
             BackgroundColor="#2E073F">

    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*, Auto, *" Padding="20">

        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="3" HorizontalOptions="Center" Spacing="10" Margin="0,0,0,20">
            <Label Text="Mode Replay" TextColor="White" FontSize="28" FontFamily="MoreSugar" HorizontalOptions="Center"/>
            <Label Text="{Binding InfoTourCourant}" TextColor="#E0B0FF" FontSize="28" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Button Text="Retour" WidthRequest="220" HeightRequest="70" FontSize="20" BackgroundColor="Red" TextColor="Black" HorizontalOptions="Start" BorderColor="Black" BorderWidth="3" FontFamily="MoreSugar" Grid.Column="0" CornerRadius="20" Clicked="OnRetourClicked" local:HoverBehavior.CursorHoverType="Hand"/>

        <Button
    IsVisible="{Binding VarianteEstActivee}"
            Grid.Column="2"
            HorizontalOptions="End"
    Text="50' Reverse"
    WidthRequest="200"
    HeightRequest="70"
    FontSize="20"
    TextColor="White"
    BorderColor="White"
    BorderWidth="3"
    FontFamily="MoreSugar"
    CornerRadius="20">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#8A2BE2" Offset="0.0" />
                    <GradientStop Color="#FF0000" Offset="1.0" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        
        <VerticalStackLayout Grid.Row="1" Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
            <Border Stroke="AntiqueWhite" StrokeShape="RoundRectangle 20" StrokeThickness="4" BackgroundColor="#4D7A1CAC">
                <Grid RowDefinitions="*,*" Margin="20">
                    <Image Source="{Binding AvatarJoueur1}" WidthRequest="150" HeightRequest="150" Aspect="AspectFit"/>
                    <Label Grid.Row="1" Text="{Binding NomJoueur1}" TextColor="White" HorizontalOptions="Center" FontSize="Large" FontFamily="MoreSugar" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#7A1CAC" StrokeThickness="6" Stroke="WhiteSmoke" StrokeShape="RoundRectangle 20" Padding="10" WidthRequest="500" HeightRequest="500" HorizontalOptions="Center" VerticalOptions="Center">
            <CollectionView ItemsSource="{Binding Grille}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="5" VerticalItemSpacing="5"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CelluleModel">
                        <Border Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 10" HeightRequest="105" WidthRequest="105" BackgroundColor="#5A0E82">
                            <Image Source="{Binding CheminImage}" Margin="5" Aspect="AspectFill"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <VerticalStackLayout Grid.Row="1" Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
            <Border Stroke="AntiqueWhite" StrokeShape="RoundRectangle 20" StrokeThickness="4" BackgroundColor="#4D7A1CAC">
                <Grid RowDefinitions="*,*" Margin="20">
                    <Image Source="{Binding AvatarJoueur2}" WidthRequest="150" HeightRequest="150" Aspect="AspectFit"/>
                    <Label Grid.Row="1" Text="{Binding NomJoueur2}" TextColor="White" HorizontalOptions="Center" FontSize="Large" FontFamily="MoreSugar" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,*" ColumnSpacing="50" HorizontalOptions="Center" Margin="0,30,0,0">
            <Button Grid.Column="0" Text="&lt; Précédent" Command="{Binding CommandePrecedent}" WidthRequest="200" HeightRequest="60" FontSize="20" BackgroundColor="#8B00CC" TextColor="White" FontFamily="MoreSugar" BorderWidth="3" BorderColor="Black" CornerRadius="15" local:HoverBehavior.CursorHoverType="Hand"/>
            <Button Grid.Column="1" Text="Suivant &gt;" Command="{Binding CommandeSuivant}" WidthRequest="200" HeightRequest="60" FontSize="20" BackgroundColor="#8B00CC" TextColor="White" FontFamily="MoreSugar" BorderWidth="3" BorderColor="Black" CornerRadius="15" local:HoverBehavior.CursorHoverType="Hand"/>
        </Grid>

    </Grid>
</ContentPage>