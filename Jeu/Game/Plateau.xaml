<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game.Plateau"
             BackgroundColor="#2E073F"
             Title="Plateau">

    <Border Stroke="Black" StrokeThickness="3" Margin="10" BackgroundColor="Transparent">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, *" Margin="10">

            <Button Grid.Row="0" Grid.Column="0"
                    Text="QUITTER LA PARTIE"
                    FontFamily="MoreSugar" 
                    BackgroundColor="Red" 
                    TextColor="Black"
                    BorderColor="Black"
                    BorderWidth="3"
                    CornerRadius="15" 
                    HeightRequest="60" 
                    Margin="10"
                    Clicked="OnRetourClicked"
                    HorizontalOptions="Start" 
                    VerticalOptions="Start"/>

            <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Start" Spacing="-5">
                <Label Text="ORBITO" FontFamily="MoreSugar" FontSize="48" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Tour de Joueur X" FontFamily="MoreSugar" FontSize="16" TextColor="White" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Margin="20,10,10,10" Spacing="25" WidthRequest="280">

                <Border Stroke="Black" StrokeThickness="3" BackgroundColor="DarkViolet" HeightRequest="240">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                        <Border Stroke="Black" StrokeThickness="3" BackgroundColor="Transparent" WidthRequest="140" HeightRequest="140">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                        </Border>
                        <Label Text="Carte Joueur 1" FontFamily="MoreSugar" FontSize="22" TextColor="Black" HorizontalOptions="Center" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="Black" StrokeThickness="3" BackgroundColor="DarkViolet" Padding="15" VerticalOptions="FillAndExpand">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                        <Label Text="8" FontFamily="MoreSugar" FontSize="90" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                        <Label Text="COMPTEUR BILLES&#x0a;JOUEUR 1" FontFamily="MoreSugar" FontSize="18" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center" />
                        <Ellipse Fill="White" Stroke="Black" StrokeThickness="4" WidthRequest="160" HeightRequest="160" HorizontalOptions="Center" Margin="0,20,0,0"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <Border Grid.Row="1" Grid.Column="1" Stroke="Black" StrokeThickness="3" BackgroundColor="#2E073F" Margin="20" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="600" HeightRequest="600">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <Grid Padding="15" RowSpacing="5" ColumnSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Stroke="Black" StrokeThickness="3" Margin="-5" />

                    <Image Grid.Row="0" Grid.Column="0" Source="boite.png" Rotation="90" Aspect="AspectFit" />
                    <Image Grid.Row="0" Grid.Column="1" Source="boite.png" Rotation="180" Aspect="AspectFit" />
                    <Image Grid.Row="0" Grid.Column="2" Source="boite.png" Rotation="180" Aspect="AspectFit" />
                    <Image Grid.Row="0" Grid.Column="3" Source="boite.png" Rotation="180" Aspect="AspectFit" />

                    <Image Grid.Row="1" Grid.Column="0" Source="boite.png" Rotation="90" Aspect="AspectFit" />
                    <Image Grid.Row="1" Grid.Column="1" Source="boite.png" Rotation="90" Aspect="AspectFit" />
                    <Image Grid.Row="1" Grid.Column="2" Source="boite.png" Rotation="180" Aspect="AspectFit" />
                    <Image Grid.Row="1" Grid.Column="3" Source="boite.png" Rotation="270" Aspect="AspectFit" />

                    <Image Grid.Row="2" Grid.Column="0" Source="boite.png" Rotation="90" Aspect="AspectFit" />
                    <Image Grid.Row="2" Grid.Column="1" Source="boite.png" Rotation="0" Aspect="AspectFit" />
                    <Image Grid.Row="2" Grid.Column="2" Source="boite.png" Rotation="270" Aspect="AspectFit" />
                    <Image Grid.Row="2" Grid.Column="3" Source="boite.png" Rotation="270" Aspect="AspectFit" />

                    <Image Grid.Row="3" Grid.Column="0" Source="boite.png" Rotation="0" Aspect="AspectFit" />
                    <Image Grid.Row="3" Grid.Column="1" Source="boite.png" Rotation="0" Aspect="AspectFit" />
                    <Image Grid.Row="3" Grid.Column="2" Source="boite.png" Rotation="0" Aspect="AspectFit" />
                    <Image Grid.Row="3" Grid.Column="3" Source="boite.png" Rotation="270" Aspect="AspectFit" />

                    <Ellipse Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Fill="Red" Stroke="Black" StrokeThickness="3" WidthRequest="65" HeightRequest="65" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

            </Border>

            <VerticalStackLayout Grid.Row="1" Grid.Column="2" Margin="10,10,20,10" Spacing="25" WidthRequest="280">

                <Border Stroke="Black" StrokeThickness="3" BackgroundColor="DarkViolet" HeightRequest="240">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                        <Border Stroke="Black" StrokeThickness="3" BackgroundColor="Transparent" WidthRequest="140" HeightRequest="140">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                        </Border>
                        <Label Text="Carte Joueur 2" FontFamily="MoreSugar" FontSize="22" TextColor="Black" HorizontalOptions="Center" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="Black" StrokeThickness="3" BackgroundColor="DarkViolet" Padding="15" VerticalOptions="FillAndExpand">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                        <Label Text="8" FontFamily="MoreSugar" FontSize="90" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                        <Label Text="COMPTEUR BILLES&#x0a;JOUEUR 2" FontFamily="MoreSugar" FontSize="18" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="Center" />
                        <Ellipse Fill="Black" Stroke="White" StrokeThickness="4" WidthRequest="160" HeightRequest="160" HorizontalOptions="Center" Margin="0,20,0,0"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentPage>