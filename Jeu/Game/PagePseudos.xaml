<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game.New"
             BackgroundColor="#2E073F">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="orbitowhite_nobg.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Logo Orbito" />

            

            <HorizontalStackLayout
                Padding="30"
                Spacing="200"
                HorizontalOptions="Center"
               
                >
                <VerticalStackLayout
                    Margin="10"
                    WidthRequest="400"
                    Spacing="15"
                     

                    >


                    <Grid Padding="30"
                          RowDefinitions="*,200,*">
                        
                        <Label
                            Text="Joueur 1"
                            VerticalOptions="Start"
                            Grid.Row="0"
                            />
                        <Border
                            Grid.Row="1"
                            WidthRequest="200"
                            StrokeShape="RoundRectangle 100"
                            Stroke="WhiteSmoke"
                            BackgroundColor="#7A1CAC"
                            StrokeThickness="6"
                            >
                            <Image
                            
                                Source="dotnet_bot.png"
                                Aspect="AspectFit"
                                />
                        </Border>
                        <Entry
                            Margin="0,30,0,0"
                            VerticalOptions="End"
                            Placeholder="Entrez le pseudo ici"
                            WidthRequest="400"
                            Grid.Row="2"
                            />

                    </Grid>

                </VerticalStackLayout>
                <VerticalStackLayout
                    Margin="10"
                    WidthRequest="400"
                    Spacing="15"
                    >


                    <Grid 
                        Padding="30"
                        RowDefinitions="*,200,*">

                        <Label
                            Text="Joueur 2"
                            VerticalOptions="Start"
                            Grid.Row="0"
                            />
                        <Border
                            Grid.Row="1"
                            WidthRequest="200"
                            StrokeShape="RoundRectangle 100"
                            Stroke="WhiteSmoke"
                            BackgroundColor="#7A1CAC"
                            StrokeThickness="6"
                            >
                            <Image
                                Source="dotnet_bot.png"
                                Aspect="AspectFit"
                                />
                        </Border>
                        <Entry
                            Margin="0,30,0,0"
                            VerticalOptions="End"
                            Placeholder="Entrez le pseudo ici"
                            WidthRequest="400"
                            Grid.Row="2"
                            />
                    </Grid>

                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Button
                Text="Lancer la partie"
                WidthRequest="700"
                HeightRequest="70"
                FontSize="40"
                />

            <Grid Padding="20">

                <Button
                    Text="Retour"
                    WidthRequest="200"
                    HeightRequest="70"
                    FontSize="30"
                    BackgroundColor="Red"
                    TextColor="Black"
                    HorizontalOptions="Start"
                    BorderColor="Black"
                    BorderWidth="3"
                    
                    Grid.Column="0"
                    />

                

            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
