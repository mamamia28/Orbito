<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game.PageJoueurVSIA"
             xmlns:local="clr-namespace:Game.Behaviors"
             BackgroundImageSource="fond_mac.jpg">
    <ScrollView>
        <Grid>
            <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
                <Border
                BackgroundColor="Transparent"
                Stroke="Transparent">
                    <Button
                BackgroundColor="Transparent"
            
                HeightRequest="185"
                Text="Orbito"
                FontSize="150"
                TextColor="White"
                FontFamily="MoreSugar"
                SemanticProperties.Description="Logo Orbito" />
                </Border>



                <HorizontalStackLayout
                Padding="10"
                Spacing="200"
                HorizontalOptions="Center"
           
                >
                    <VerticalStackLayout
                        Margin="10"
                        WidthRequest="400"
                        Spacing="15"


                            >

                            
                        <Grid Padding="30"
                          RowDefinitions="Auto,200,Auto,Auto,Auto">

                            <Label
                                Text="Joueur 1"
                                VerticalOptions="Start"
                                HorizontalOptions="Center"
                                FontFamily="MoreSugar"
                                Grid.Row="0"
                            />
                            <Border
                            Grid.Row="1"
                            WidthRequest="200"
                            StrokeShape="RoundRectangle 100"
                            Stroke="WhiteSmoke"
                            BackgroundColor="Transparent"
                            StrokeThickness="6"
                            >
                                <Image
                        
                                Source="{Binding CheminImage }"
                                Aspect="AspectFit"
                                />
                            </Border>
                            <Label
                                Grid.Row="2"
                                HorizontalOptions="Start"
                                FontFamily="MoreSugar"
                                Text="Choisissez votre avatar"/>
                            <Picker
                                Grid.Row="3"
                                ItemsSource="{Binding ListeAvatars}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding AvatarSelectionne, Mode=TwoWay}"
                                BackgroundColor="#44000000"
                                FontFamily="MoreSugar"
                                VerticalOptions="End"
                                />
                            <Entry
                                Margin="0,10,0,0"
                                VerticalOptions="Start"
                                Text="{Binding Pseudo1}"
                                Placeholder="Entrez le pseudo ici"
                                FontFamily="MoreSugar"
                                BackgroundColor="#44000000"
                                WidthRequest="400"
                                Grid.Row="4"
                            />

                        </Grid>

                    </VerticalStackLayout>
                    <VerticalStackLayout
                    Margin="10"
                    WidthRequest="400"
                    Spacing="15"
                    >

                        <Border
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 25"
                            Padding="40,0,40,0">
                        <Grid 
                            Padding="30"
                            RowDefinitions="*,200,*"
                            >

                            <Label
                                Text="IA"
                                VerticalOptions="Start"
                                HorizontalOptions="Center"
                                FontFamily="MoreSugar"
                                FontSize="18"
                                Grid.Row="0"
                                />
                                <Border
                                    Grid.Row="1"
                                    WidthRequest="200"
                                    StrokeShape="RoundRectangle 100"
                                    Stroke="WhiteSmoke"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="6"
                                    >
                                    <Image
                                        Source="ia.png"
                                        Aspect="AspectFit"
                                        />
                                </Border>
                                <Picker 
                                    ItemsSource="{Binding ListeDifficultes}"
                                    SelectedItem ="{Binding DifficulteSelectionnee}"
                                    Title="Choisir la difficulté"
                                    WidthRequest="400"
                                    Margin="5,30,0,0"
                                    Grid.Row="2"
                                    FontFamily="MoreSugar"
                                    HorizontalOptions="Center"
                                    BackgroundColor="#44000000"
                                    VerticalTextAlignment="Center"
                                    />
                        </Grid>
                        </Border>

                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 25"
                    StrokeThickness="0">
                        <Button
                            local:HoverBehavior.CursorHoverType="Hand"
                            Text="Lancer la partie"
                            WidthRequest="700"
                            
                            Padding="0"
                            HeightRequest="75"
                            FontFamily="MoreSugar"
                            BorderColor="AntiqueWhite"
                            BorderWidth="5"
                            CornerRadius="25"
                            FontSize="50"
                            Clicked="OnPlateauClicked"
                            />
                </Border>

                <Grid Padding="20">

                    <Button
                    Text="="
                    WidthRequest="200"
                    HeightRequest="70"
                    FontSize="30"
                    BackgroundColor="Red"
                    TextColor="Black"
                    HorizontalOptions="Start"
                    BorderColor="Black"
                    BorderWidth="3"
                    FontFamily="MoreSugarExtras"
                    Grid.Column="0"
                    IsVisible="True"
                    IsEnabled="True"
                    CornerRadius="20"
                    local:HoverBehavior.CursorHoverType="Hand"
                    Clicked="OnRetourClicked"
                    />

                </Grid>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>