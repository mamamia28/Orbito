<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Game.Behaviors"
             x:Class="Game.PageJoueurVSJoueur"
             BackgroundColor="#2E073F">

    <ScrollView>
    <Grid>
        <VerticalStackLayout
                Padding="30,0"
                Spacing="15">
            <Border
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                <Button
                    BackgroundColor="Transparent"
                
                    HeightRequest="185"
                    Text="Orbito"
                    FontSize="150"
                    TextColor="White"
                    FontFamily="MoreSugar"
                    SemanticProperties.Description="Logo Orbito" />
            </Border>



            <HorizontalStackLayout
                    Padding="30"
                    Spacing="200"
                    HorizontalOptions="Center"
               
                    >
                <VerticalStackLayout
                        Margin="10"
                        WidthRequest="400"
                        Spacing="15"
                     

                        >


                    <Grid Padding="30"
                              RowDefinitions="*,200,*,*">

                        <Label
                                Text="Joueur 1"
                                VerticalOptions="Start"
                                Grid.Row="0"
                                />
                        <Border
                                Grid.Row="1"
                                WidthRequest="200"
                                StrokeShape="RoundRectangle 100"
                                Stroke="WhiteSmoke"
                                BackgroundColor="#7A1CAC"
                                StrokeThickness="6"
                                >
                            <Image
                            
                                    Source="{Binding CheminImage}"
                                    Aspect="AspectFit"
                                    />
                        </Border>
                            <Picker
                                Grid.Row="2"
                                ItemsSource="{Binding ListeAvatars}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding AvatarSelectionne, Mode=TwoWay}"
                                />
                            <Entry
                                Margin="0,30,0,0"
                                VerticalOptions="End"
                                Text="{Binding Pseudo1}"
                                Placeholder="Entrez le pseudo blanc ici"
                                WidthRequest="400"
                                Grid.Row="3"
                                />

                    </Grid>

                </VerticalStackLayout>
                <VerticalStackLayout
                        Margin="10"
                        WidthRequest="400"
                        Spacing="15"
                        >


                    <Grid 
                            Padding="30"
                            RowDefinitions="*,200,*,*">

                        <Label
                                Text="Joueur 2"
                                VerticalOptions="Start"
                                Grid.Row="0"
                                />
                        <Border
                                Grid.Row="1"
                                WidthRequest="200"
                                StrokeShape="RoundRectangle 100"
                                Stroke="WhiteSmoke"
                                BackgroundColor="#7A1CAC"
                                StrokeThickness="6"
                                >
                            <Image
                                    Source="{Binding CheminImage2}"
                                    Aspect="AspectFit"
                                    />
                        </Border>
                            <Picker
                                Grid.Row="2"
                                ItemsSource="{Binding ListeAvatars}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding AvatarSelectionne2, Mode=TwoWay}"
                                />
                            <Entry
                                Margin="0,30,0,0"
                                VerticalOptions="End"
                                Text="{Binding Pseudo2}"
                                Placeholder="Entrez le pseudo noir ici"
                                WidthRequest="400"
                                Grid.Row="3"
                                />
                    </Grid>

                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Border
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                <Button
                    local:HoverBehavior.CursorHoverType="Hand"
                    Text="Lancer la partie"
                    WidthRequest="700"
                    Padding="0"
                    HeightRequest="70"
                    FontFamily="MoreSugar"
                    LineBreakMode="WordWrap"
                    FontSize="50"
                    Clicked="OnPlateauClicked"
                    />
            </Border>

            <Grid Padding="20">

                <Button
                        Text="="
                        WidthRequest="200"
                        HeightRequest="70"
                        FontSize="30"
                        BackgroundColor="Red"
                        TextColor="Black"
                        HorizontalOptions="Start"
                        BorderColor="Black"
                        BorderWidth="3"
                        FontFamily="MoreSugarExtras"
                        Grid.Column="0"
                        IsVisible="True"
                        IsEnabled="True"
                        CornerRadius="20"
                        local:HoverBehavior.CursorHoverType="Hand"
                        Clicked="OnRetourClicked"
                        />

            </Grid>
        </VerticalStackLayout>
    </Grid>
    </ScrollView>

</ContentPage>
