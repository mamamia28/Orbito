<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             x:Class="Game.MainPage"
             xmlns:local="clr-namespace:Game.Behaviors"
             BackgroundColor="#2E073F">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Grid
                ColumnDefinitions="*"
                RowDefinitions="*,*,*">
            <Button
                    Grid.Row="0"
                    VerticalOptions="Start"
                    Grid.Column="0"
                    Text="Orbito"
                    HeightRequest="200"
                    FontFamily="MoreSugar"
                    FontSize="150"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    
                    SemanticProperties.Description="Logo Orbito" 
                    HorizontalOptions="Center"
                    />
            
            <Border
                Grid.Row="0"
                Grid.RowSpan="2"
                Margin="0,150,0,0"
                HorizontalOptions="End"
                WidthRequest="260"
                HeightRequest="400"
                Stroke="Transparent"
                StrokeShape="0"
                StrokeThickness="2">
                
                <Grid Padding="30" RowDefinitions="Auto, auto" RowSpacing="15">
                    
                    <Button
                        Text="HISTORIQUE"
                        WidthRequest="250"
                        HeightRequest="100"
                        FontFamily="MoreSugar"
                        FontSize="30"
                        BorderColor="White"
                        BorderWidth="2"
                        Grid.Row="0"
                        TextColor="White"
                        VerticalOptions="Center"
                        local:HoverBehavior.CursorHoverType="Hand"
                    />
                    <Button
                        Text="STATS"
                        WidthRequest="250"
                        FontFamily="MoreSugar"
                        HeightRequest="100"
                        FontSize="30"
                        BorderColor="White"
                        BorderWidth="2"
                        Grid.Row="1"
                        VerticalOptions="Center"
                        TextColor="White"
                        Margin="0,40,0,0"
                        local:HoverBehavior.CursorHoverType="Hand"
                    />
                </Grid>
                
            </Border>
            <Grid Padding="30"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  VerticalOptions="End"
                  Margin="0,00,0,0">
                <Button
                    Text="Quitter"
                    FontFamily="MoreSugar"
                    WidthRequest="200"
                    HeightRequest="70"
                    FontSize="30"
                    BackgroundColor="Red"
                    TextColor="Black"
                    HorizontalOptions="Start"
                    BorderColor="Black"
                    BorderWidth="3"
                    Margin="0, 350, 0, 0"
                    Grid.Column="0"
                    CornerRadius="15"
                    local:HoverBehavior.CursorHoverType="Hand"
                    />

                <Button
                    Text="Jouer"
                    FontFamily="MoreSugar"
                    Padding="20"
                    Clicked="OnPlayClicked"
                    BackgroundColor="DarkViolet"
                    TextColor="Black"
                    BorderColor="Black"
                    BorderWidth="3"
                    WidthRequest="600"
                    HeightRequest="300"
                    FontSize="150"
                    Margin="0, 00, 0, 0"
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    CornerRadius="45"
                    local:HoverBehavior.CursorHoverType="Hand"
                    />
            </Grid>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
