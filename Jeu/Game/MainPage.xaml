<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Game.MainPage"
             xmlns:local="clr-namespace:Game.Behaviors"
             BackgroundImageSource="fond_mac.jpg">

    <Grid Padding="0"
          ColumnDefinitions="Auto,*,Auto"
          RowDefinitions="Auto, Auto, *">

        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Text="Orbito"
                FontFamily="MoreSugar"
                FontSize="150"
                BackgroundColor="Transparent"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Start"/>

        <VerticalStackLayout Grid.Row="1" Grid.Column="2"
                             Spacing="50"
                             Padding="30"
                             VerticalOptions="Start"
                             HorizontalOptions="Center">
            <Button Text="HISTORIQUE"
                    WidthRequest="250" HeightRequest="100"
                    FontFamily="MoreSugar" FontSize="30"
                    BackgroundColor="CadetBlue" TextColor="White"
                    BorderColor="White" BorderWidth="2"
                    Clicked="OnHistoriqueClicked"
                    local:HoverBehavior.CursorHoverType="Hand"/>

            <Button Text="STATS"
                    WidthRequest="250" HeightRequest="100"
                    FontFamily="MoreSugar" FontSize="30"
                    BackgroundColor="CadetBlue" TextColor="White"
                    BorderColor="White" BorderWidth="2"
                    Clicked="OnStatistiquesClicked"
                    local:HoverBehavior.CursorHoverType="Hand"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                             Spacing="20"
                             VerticalOptions="Center"
                             HorizontalOptions="Center">
            

            <Button Text="Jouer"
                    FontFamily="MoreSugar" FontSize="150"
                    BackgroundColor="DarkViolet" TextColor="Black"
                    BorderColor="Black" BorderWidth="3"
                    WidthRequest="600" HeightRequest="350"
                    Margin="0,150,0,0"
                    CornerRadius="55"
                    Clicked="OnPlayClicked"
                    local:HoverBehavior.CursorHoverType="Hand"/>
        </VerticalStackLayout>

        <Button Grid.Row="2" Grid.Column="0"
            Margin="30,0,0,30"
            Text="Quitter"
            FontFamily="MoreSugar" FontSize="30"
            BackgroundColor="Red" TextColor="Black"
            BorderColor="Black" BorderWidth="3"
            WidthRequest="250" HeightRequest="70"
            CornerRadius="15"
            VerticalOptions="End"
            HorizontalOptions="Start"
            Clicked="OnQuitterClicked"
            local:HoverBehavior.CursorHoverType="Hand"/>

        <Button x:Name="BtnCredits" Grid.Row="2" Grid.Column="2"
            Margin="0,0,30,30"
            Text="Crédits"
            FontFamily="MoreSugar" FontSize="30"
            BackgroundColor="White" TextColor="Black"
            BorderColor="Black" BorderWidth="3"
            WidthRequest="250" HeightRequest="70"
            CornerRadius="15"
            VerticalOptions="End"
            HorizontalOptions="End" 
            local:HoverBehavior.CursorHoverType="Hand"
            Clicked="OnCreditsClicked" />

        <Grid x:Name="PopupCredits" 
      IsVisible="False" 
      BackgroundColor="#B3000000" 
      Padding="0"
      Grid.Row="0" Grid.RowSpan="3"
      Grid.Column="0" Grid.ColumnSpan="3"
      VerticalOptions="Fill"
      HorizontalOptions="Fill"
      ZIndex="99">

            <Border BackgroundColor="#2E073F" Stroke="White" StrokeThickness="3" StrokeShape="RoundRectangle 20"
            VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="900" HeightRequest="700" Padding="30">

                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="20">

                    <Grid Grid.Row="0">
                        <Border Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="15" HorizontalOptions="Center">
                            <Label Text="CREDITS" FontSize="45" FontFamily="MoreSugar" FontAttributes="Bold" TextColor="White" />
                        </Border>

                        <Button Text="X" FontSize="35" FontAttributes="Bold" TextColor="White" BackgroundColor="Transparent"
                        WidthRequest="60" HeightRequest="60" 
                        HorizontalOptions="End" VerticalOptions="Center"
                        Clicked="OnCloseCreditsClicked" local:HoverBehavior.CursorHoverType="Hand" />
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">

                        <Label Text="REALISE PAR" 
                       FontSize="22" FontFamily="MoreSugar" TextColor="#E0A9F5" HorizontalTextAlignment="Center" />

                        <Label Text="Adil MANSAR, Samet CINAR, Mael BUSSON" 
                       FontSize="32" FontFamily="MoreSugar" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />

                        <Label Text="Avec la formation de l'IUT Informatique d'AUBIERE" 
                       FontSize="20" FontFamily="MoreSugar" TextColor="White" HorizontalTextAlignment="Center" Margin="0,15,0,0" />

                        <Label Text="Remerciements particuliers à nos professeurs de TD, TP et amphi :" 
                       FontSize="18" FontFamily="MoreSugar" TextColor="#E0A9F5" HorizontalTextAlignment="Center" Margin="0,15,0,0"/>

                        <Label Text="Marc CHEVALDONNE&#10;Kevin DA SILVA&#10;Camille PETITALOT" 
                       FontSize="24" FontFamily="MoreSugar" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" LineHeight="1.2" />

                    </VerticalStackLayout>

                    <Image Grid.Row="2" 
                   Source="logo_uca.png" 
                   WidthRequest="300" 
                   HeightRequest="120" 
                   Aspect="AspectFit" 
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
        <Grid 
            x:Name="PopUpReprendre"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
            Grid.Row="0" Grid.RowSpan="3"
            Grid.Column="0" Grid.ColumnSpan="3"
            BackgroundColor="#EE2E073F"
            IsVisible="True"
            
            
            ZIndex="100"
            >
            <Border
                WidthRequest="1100"
                HeightRequest="400"
                VerticalOptions="Center"
                BackgroundColor="#2E073F"
                Stroke="PapayaWhip"
                StrokeShape="RoundRectangle 40"
                StrokeThickness="4"
                >
                <Grid
                    RowDefinitions="*,Auto,*"
                    ColumnDefinitions="*,*">
                    <Button
                        Grid.Row="1"
                        Grid.Column="0" Grid.ColumnSpan="2"
                        Text="Reprendre la partie"
                        FontFamily="MoreSugar" FontSize="40"
                        BackgroundColor="#FFD700" TextColor="Black"
                        BorderColor="Black" BorderWidth="3"
                        WidthRequest="600" HeightRequest="80"
                        CornerRadius="25"
                        ZIndex="100"
                        Clicked="OnReprendreClicked"
                        local:HoverBehavior.CursorHoverType="Hand"/>
                    <Button
                        Text="X"
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="20"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        FontSize="30"
                        local:HoverBehavior.CursorHoverType="Hand"
                        Clicked="OnCloseReprendreClicked"/>
                    <Label
                        Text="La partie a été coupée, voulez vous la reprendre ?"
                        FontFamily="MoreSugar"
                        FontSize="40"
                        Grid.Row="0"
                        Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalOptions="Center"
                        Margin="30"
                        local:HoverBehavior.CursorHoverType="IBeam"
                        
                        />
                </Grid>
            </Border>
        </Grid>

    </Grid>
    
</ContentPage>